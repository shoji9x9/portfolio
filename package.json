{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/only-allow-pnpm.mjs",
    "prepare": "lefthook install",
    "dev": "vp dev",
    "build": "vp build",
    "start": "pnpm run build && vp preview",
    "preview": "vp preview",
    "test": "vitest run --coverage",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "typecheck": "tsc -b",
    "lint": "vp lint -c oxlint.config.ts --type-aware && node --import tsx scripts/check-tailwind-canonical.ts",
    "lint:fix": "vp lint -c oxlint.config.ts --type-aware --fix",
    "lint:md": "markdownlint-cli2",
    "check:node-version": "tsx scripts/check-node-version-parity.ts",
    "lint:sh": "git ls-files -z '*.sh' '*.bash' ':(exclude).agents/**' ':(exclude).claude/**' | xargs -0 sh -c 'test \"$#\" -eq 0 || shellcheck --external-sources \"$@\"' _ && git ls-files -z '*.sh' '*.bash' ':(exclude).agents/**' ':(exclude).claude/**' | xargs -0 sh -c 'test \"$#\" -eq 0 || shfmt -d \"$@\"' _",
    "format": "vp fmt -c oxfmt.config.ts",
    "format:check": "vp fmt -c oxfmt.config.ts --check",
    "knip": "knip --no-config-hints",
    "jscpd": "jscpd",
    "commitlint": "commitlint --edit",
    "license:check": "pnpm licenses list --json | tsx scripts/check-licenses.ts",
    "react:doctor": "bash scripts/react-doctor-gate.sh"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.25",
    "clsx": "^2.1.1",
    "inter-ui": "3.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "jscpd": "^5.0.14",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxlint-tailwindcss": "^1.9.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "react-doctor": "^0.9.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "~7.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "packageManager": "pnpm@11.21.0"
}
