{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test --passWithNoTests",
    "typecheck": "tsc -b",
    "lint": "vp lint -c oxlint.config.ts --type-aware",
    "lint:fix": "vp lint -c oxlint.config.ts --type-aware --fix",
    "lint:md": "markdownlint-cli2",
    "lint:sh": "git ls-files -z '*.sh' '*.bash' | xargs -0 -r shellcheck && git ls-files -z '*.sh' '*.bash' | xargs -0 -r shfmt -d",
    "format": "vp fmt -c oxfmt.config.ts",
    "format:check": "vp fmt -c oxfmt.config.ts --check",
    "knip": "knip --no-config-hints",
    "jscpd": "jscpd",
    "depcruise": "depcruise src --config .dependency-cruiser.js",
    "commitlint": "commitlint --edit",
    "license:check": "pnpm licenses list --json | tsx scripts/check-licenses.ts",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.1.0",
    "jscpd": "^4.0.0",
    "knip": "^6.27.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.1",
    "oxlint-tailwindcss": "^1.3.5",
    "react-doctor": "^0.7.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "turbo": "^2.10.2",
    "typescript": "~7.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.17.0"
}
