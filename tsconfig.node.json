{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // preinstall 用の素の Node スクリプト（.mjs）に型情報を与えるため許可する
    // （checkJs は無効なので型検査はせず、oxlint の型認識に Node 型を供給するだけ）。
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "*.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "seed/**/*.ts",
    "functions/**/*.ts"
  ],
  // playwright.config.ts は e2e プロジェクト（tsconfig.e2e.json）が持つ。
  // スペックが VIEWPORTS を import するため、同じプロジェクトに入っている必要がある。
  "exclude": ["playwright.config.ts"]
}
